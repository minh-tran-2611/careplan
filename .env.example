# Copy to .env if desired; never commit an API key.
NVIDIA_API_KEY=
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TIMEOUT_SECONDS=90
# Optional embeddings; leave blank to use keyword retrieval.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
ENABLE_LONG_TERM_MEMORY=false
HOST=127.0.0.1
PORT=8000

# Separate embedding credential; never expose in frontend.
EMBEDDING_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=nursing_nemotron35_8b_v1
